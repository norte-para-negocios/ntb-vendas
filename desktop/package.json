{
  "name": "ntb-vendas-desktop",
  "version": "1.2.4",
  "private": true,
  "description": "Norte Vendas — app desktop (Windows)",
  "main": "electron/main.js",
  "scripts": {
    "build:web": "cd .. && npx next build desktop/webapp",
    "dev": "npm run build:web && electron .",
    "dist": "npm run build:web && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.norteparanegocios.ntbvendas",
    "productName": "Norte Vendas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "webapp/out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "compression": "store",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "customNsisBinary": {
        "url": "https://github.com/electron-userland/electron-builder-binaries/releases/download/nsis-3.0.4.1/nsis-3.0.4.1.7z",
        "checksum": "VKMiizYdmNdJOWpRGz4trl4lD++BvYP2irAXpMilheUP0pc93iKlWAoP843Vlraj8YG19CVn0j+dCo/hURz9+Q=="
      }
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.norteparanegocios.com.br/ntb-vendas-desktop/"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
