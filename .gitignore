# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scripts cache
scripts/.pooler-host

# git worktrees (superpowers:using-git-worktrees)
/.worktrees

# Superpowers brainstorming companion (mockup scratch, não é código do produto)
.superpowers/

# Agente local de impressão (print-agent/) — config.json tem o slug real
# da loja de cada instalação; cada computador da loja tem o seu, nunca
# deve ser commitado por cima do outro. node_modules idem (instalado
# localmente na loja via npm install, não versionado).
/print-agent/config.json
/print-agent/node_modules
